<rxui:ReactiveUserControl x:TypeArguments="local:HourRow"
                          x:DataType="local:HourRow"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:local="using:KrolikGR.Src.Features.Schedule.UI.Screens.DayDetails"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:rxui="http://reactiveui.net"
                          x:Class="KrolikGR.Src.Features.Schedule.UI.Screens.DayDetails.ScreenComponents.DayDetailsRowView">
    
    <Grid ColumnDefinitions="80, *, *, *, *">
        <Border Grid.Column="0" Classes="TableCell"><TextBlock x:Name="HourText" Classes="HourText"/></Border>
        <Border Grid.Column="1" Classes="TableCell"><TextBlock x:Name="StaffText" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <Border Grid.Column="2" Classes="TableCell"><TextBlock x:Name="ServiceHeadText" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <Border Grid.Column="3" Classes="TableCell"><TextBlock x:Name="ShiftManagerText" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <Border Grid.Column="4" Classes="TableCell"><TextBlock x:Name="CleanerText" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</rxui:ReactiveUserControl>
