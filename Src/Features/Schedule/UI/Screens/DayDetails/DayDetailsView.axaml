<rxui:ReactiveUserControl x:TypeArguments="local:DayDetailsViewModel"
                          x:DataType="local:DayDetailsViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:local="using:KrolikGR.Src.Features.Schedule.UI.Screens.DayDetails"
                          xmlns:components="using:KrolikGR.Src.Features.Schedule.UI.Screens.DayDetails.ScreenComponents"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:rxui="http://reactiveui.net"
                          x:Class="KrolikGR.Src.Features.Schedule.UI.Screens.DayDetails.DayDetailsView">
    
    <UserControl.Styles>
        <StyleInclude Source="avares://KrolikGR/Src/Features/Schedule/UI/Screens/DayDetails/ScreenStyles/DayDetailsStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="20,10" BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button x:Name="BackButton" Classes="Back">
                    <Path x:Name="BackPath" Data="M 10 0 L 0 10 L 10 20" StrokeThickness="2" />
                </Button>
                
                <TextBlock x:Name="DateTitle" Grid.Column="1" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="AddCrewButton" Classes="Action">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="M 0 5 L 10 5 M 5 0 L 5 10" StrokeThickness="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Załoga" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AddManagerButton" Classes="Action">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="M 0 5 L 10 5 M 5 0 L 5 10" StrokeThickness="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Managerowie" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ShowShiftCrewButton" Classes="Action">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="M 2 10 L 10 10 M 2 6 L 10 6 M 2 2 L 10 2" StrokeThickness="2" VerticalAlignment="Center"/>
                            <TextBlock Text="Osoby na zmianie" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Table Header -->
        <Border Grid.Row="1" Margin="20,10,20,0" BorderBrush="{DynamicResource SystemControlBackgroundBaseMediumBrush}" BorderThickness="1,1,0,0">
            <Grid ColumnDefinitions="80, *, *, *, *">
                 <Border Grid.Column="0" Classes="TableHeader"><TextBlock Text="Godz." Classes="RoleHeader"/></Border>
                 <Border Grid.Column="1" Classes="TableHeader"><TextBlock Text="Załoga" Classes="RoleHeader"/></Border>
                 <Border Grid.Column="2" Classes="TableHeader"><TextBlock Text="Szef serwisu" Classes="RoleHeader"/></Border>
                 <Border Grid.Column="3" Classes="TableHeader"><TextBlock Text="Szef zmiany" Classes="RoleHeader"/></Border>
                 <Border Grid.Column="4" Classes="TableHeader" Padding="0">
                    <ComboBox x:Name="RoleSelector" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch"
                              BorderThickness="0"
                              Background="Transparent">
                        <ComboBoxItem Content="Sprzątacz" />
                        <ComboBoxItem Content="Manager" />
                        <ComboBoxItem Content="Instruktor" />
                        <ComboBoxItem Content="Lider Gościnności" />
                    </ComboBox>
                 </Border>
            </Grid>
        </Border>

        <!-- Table Body -->
        <ScrollViewer Grid.Row="2" Margin="20,0,20,20">
            <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1,1,0,0">
                <ItemsControl x:Name="HoursItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:HourRow">
                            <components:DayDetailsRowView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>
    </Grid>
</rxui:ReactiveUserControl>
